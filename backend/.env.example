# ==============================================================================
# PW67 Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your local development.
# DO NOT commit the .env file with live secrets to Git.

# Application Configuration
APP_NAME=PW67 Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# CORS Configuration
# Comma-separated list of allowed origins or JSON array
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Firebase Configuration
# Option 1: File path to Firebase Service Account JSON file (local dev)
FIREBASE_CREDENTIALS_PATH=
# Option 2: Environment variables (cloud deployments/CI)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: For multiline private keys in .env, wrap in quotes and use \n or actual linebreaks
FIREBASE_PRIVATE_KEY=

# Google Gemini AI Configuration
GEMINI_API_KEY=
